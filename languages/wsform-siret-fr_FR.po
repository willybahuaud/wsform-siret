#, php-format
msgid "SIRET %s"
msgstr "SIRET %s"

#: includes/class-field-settings.php:63
msgid "Choose a company from the list, or enter a valid 14-digit SIRET number."
msgstr "Choisissez une entreprise dans la liste, ou saisissez un numéro SIRET valide à 14 chiffres."

#: includes/class-field-settings.php:64
msgid "This establishment is closed."
msgstr "Cet établissement est fermé."

#: includes/class-field-settings.php:65
msgid "This SIRET number is not listed in the public directory of companies."
msgstr "Ce numéro SIRET ne figure pas dans l’annuaire public des entreprises."

#: includes/class-field-settings.php:66
msgid "No company found. Check the spelling, or enter the SIRET number."
msgstr "Aucune entreprise trouvée. Vérifiez l’orthographe, ou saisissez le numéro SIRET."

#: includes/class-field-settings.php:67
msgid "This number is valid, but the company is not in the public directory. Some companies choose not to be listed."
msgstr "Ce numéro est valide, mais l’entreprise ne figure pas dans l’annuaire public. Certaines entreprises choisissent de ne pas y apparaître."

#: includes/class-field-settings.php:68
msgid "Company search is unavailable right now. You can still enter the SIRET number."
msgstr "La recherche d’entreprise est indisponible pour le moment. Vous pouvez saisir le numéro SIRET."

#: includes/class-field-settings.php:69
msgid "Source: Sirene directory (Insee), via the Recherche d’entreprises API, Licence Ouverte 2.0"
msgstr "Source : répertoire Sirene (Insee), via l’API Recherche d’entreprises, Licence Ouverte 2.0"

