msgstr ""

#. Description of the plugin
#: wsform-siret.php
msgid "A WS Form field that finds a French company by name or SIRET, checks it and fills the form. Public government data, no API key."
msgstr "Un champ WS Form qui trouve une entreprise française par son nom ou son SIRET, la vérifie et remplit le formulaire. Données publiques de l’État, sans clé d’API."

#. Author of the plugin
#: wsform-siret.php
msgid "Willy Bahuaud"
msgstr ""

#. Author URI of the plugin
#: wsform-siret.php
msgid "https://wabeo.fr"
msgstr ""

#: includes/class-assets.php:70
msgid "Company suggestions"
msgstr "Suggestions d’entreprises"

#: includes/class-assets.php:71
msgid "1 company found. Use the arrow keys to browse."
msgstr "1 entreprise trouvée. Utilisez les flèches pour parcourir la liste."

#. translators: %d: number of suggestions.
#: includes/class-assets.php:73
#, php-format
msgid "%d companies found. Use the arrow keys to browse."
msgstr "%d entreprises trouvées. Utilisez les flèches pour parcourir la liste."

#: includes/class-assets.php:74
msgid "Active"
msgstr "Active"

#: includes/class-assets.php:75
msgid "Closed"
msgstr "Fermée"

#: includes/class-assets.php:76
msgid "head office"
msgstr "siège"

